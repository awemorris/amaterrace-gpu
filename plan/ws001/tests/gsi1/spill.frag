#version 450
// Forty words loaded before any is used, folded with the input, and differences across the quad
// of the result: the words are spilled, and helper lanes must read back their own for the
// differences to be right.
layout(location = 0) in vec4 colour;
layout(location = 0) out vec4 result;
layout(std430, set = 0, binding = 0) readonly buffer Input { float word[]; } src;
void main()
{
	float a0 = src.word[0];
	float a1 = src.word[1];
	float a2 = src.word[2];
	float a3 = src.word[3];
	float a4 = src.word[4];
	float a5 = src.word[5];
	float a6 = src.word[6];
	float a7 = src.word[7];
	float a8 = src.word[8];
	float a9 = src.word[9];
	float a10 = src.word[10];
	float a11 = src.word[11];
	float a12 = src.word[12];
	float a13 = src.word[13];
	float a14 = src.word[14];
	float a15 = src.word[15];
	float a16 = src.word[16];
	float a17 = src.word[17];
	float a18 = src.word[18];
	float a19 = src.word[19];
	float a20 = src.word[20];
	float a21 = src.word[21];
	float a22 = src.word[22];
	float a23 = src.word[23];
	float a24 = src.word[24];
	float a25 = src.word[25];
	float a26 = src.word[26];
	float a27 = src.word[27];
	float a28 = src.word[28];
	float a29 = src.word[29];
	float a30 = src.word[30];
	float a31 = src.word[31];
	float a32 = src.word[32];
	float a33 = src.word[33];
	float a34 = src.word[34];
	float a35 = src.word[35];
	float a36 = src.word[36];
	float a37 = src.word[37];
	float a38 = src.word[38];
	float a39 = src.word[39];
	float s = colour.x;
	s = s * 0.5 + a39 * colour.y;
	s = s * 0.5 + a38 * colour.y;
	s = s * 0.5 + a37 * colour.y;
	s = s * 0.5 + a36 * colour.y;
	s = s * 0.5 + a35 * colour.y;
	s = s * 0.5 + a34 * colour.y;
	s = s * 0.5 + a33 * colour.y;
	s = s * 0.5 + a32 * colour.y;
	s = s * 0.5 + a31 * colour.y;
	s = s * 0.5 + a30 * colour.y;
	s = s * 0.5 + a29 * colour.y;
	s = s * 0.5 + a28 * colour.y;
	s = s * 0.5 + a27 * colour.y;
	s = s * 0.5 + a26 * colour.y;
	s = s * 0.5 + a25 * colour.y;
	s = s * 0.5 + a24 * colour.y;
	s = s * 0.5 + a23 * colour.y;
	s = s * 0.5 + a22 * colour.y;
	s = s * 0.5 + a21 * colour.y;
	s = s * 0.5 + a20 * colour.y;
	s = s * 0.5 + a19 * colour.y;
	s = s * 0.5 + a18 * colour.y;
	s = s * 0.5 + a17 * colour.y;
	s = s * 0.5 + a16 * colour.y;
	s = s * 0.5 + a15 * colour.y;
	s = s * 0.5 + a14 * colour.y;
	s = s * 0.5 + a13 * colour.y;
	s = s * 0.5 + a12 * colour.y;
	s = s * 0.5 + a11 * colour.y;
	s = s * 0.5 + a10 * colour.y;
	s = s * 0.5 + a9 * colour.y;
	s = s * 0.5 + a8 * colour.y;
	s = s * 0.5 + a7 * colour.y;
	s = s * 0.5 + a6 * colour.y;
	s = s * 0.5 + a5 * colour.y;
	s = s * 0.5 + a4 * colour.y;
	s = s * 0.5 + a3 * colour.y;
	s = s * 0.5 + a2 * colour.y;
	s = s * 0.5 + a1 * colour.y;
	s = s * 0.5 + a0 * colour.y;
	result = vec4(dFdx(s), dFdy(s), s, dFdxFine(s) + colour.z);
}
