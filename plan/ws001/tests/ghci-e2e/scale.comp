#version 450
// zedBSD; Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
// The compute case of the GHCI end-to-end test: out[i] = in[i] * 3 + (i ^ 0x5a).
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Input { uint values[]; } source;
layout(std430, set = 0, binding = 1) writeonly buffer Output { uint values[]; } result;
void main()
{
	uint i = gl_GlobalInvocationID.x;
	result.values[i] = source.values[i] * 3u + (i ^ 0x5au);
}
