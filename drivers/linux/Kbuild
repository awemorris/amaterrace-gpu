#
# The ghci kernel module.  The GHCI headers (ghci_regs.h, ghci_cmd.h) come
# from the tree's include/ directory, or from hw/ in a DKMS source tree
# (make dkms-source copies them there).
#

obj-m += ghci.o
ghci-y := ghci_drv.o ghci_gem.o ghci_hw.o ghci_ioctl.o ghci_ring.o

GHCI_HW_INCLUDE := $(if $(wildcard $(src)/hw/ghci_regs.h),$(src)/hw,$(src)/../../include)

# ghci_drm.h includes "drm.h" as the uapi headers of the kernel tree do.
ccflags-y += -I$(src) -I$(src)/compat -I$(GHCI_HW_INCLUDE) \
	-I$(srctree)/include/uapi/drm
