# Amaterrace GPU
# Copyright (C) 2026 Awe Morris
# SPDX-License-Identifier: Zlib
#
# Builds and loads the GPU's bitstream for the KC705, with openXC7 or
# Vivado, and runs the RTL checks.  The tools are expected on PATH:
# yosys, nextpnr-himbaechel, bbasm, fpga-as (openXC7), vivado, and
# openFPGALoader; verilator and iverilog for the checks.  `make` alone
# prints the targets.

# Configuration (config.mk if present, otherwise config.mk.template)
ifneq ($(wildcard config.mk),)
include config.mk
CONFIG_MK_SRC := config.mk
else
include config.mk.template
CONFIG_MK_SRC := config.mk.template
endif

# Derive SU group width (GRP_W) from physical lanes (NPHYS)
ifeq ($(CONFIG_SU_NPHYS),32)
CFG_SU_GRP_W := 1
else ifeq ($(CONFIG_SU_NPHYS),16)
CFG_SU_GRP_W := 1
else ifeq ($(CONFIG_SU_NPHYS),8)
CFG_SU_GRP_W := 2
else ifeq ($(CONFIG_SU_NPHYS),4)
CFG_SU_GRP_W := 3
else
CFG_SU_GRP_W := 2
endif

BOARD ?= $(TARGET_PRESET)
TOP ?= atg_kc705_top
PART ?= xc7k325tffg900-2
DIE ?= xc7k325t
# openXC7's data: the prjxray database and nextpnr's chip-database generator.
PRJXRAY_DB_DIR ?= $(HOME)/opt/openxc7/share/nextpnr/prjxray-db
OPENXC7_SHARE ?= $(HOME)/opt/openxc7/share
FAMILY ?= kintex7

BUILD := build
OXC := $(BUILD)/openxc7/$(TOP)
CHIPDB := $(BUILD)/openxc7/chipdb/$(DIE).bin
RTL := $(sort $(shell find rtl -name '*.v' | grep -v 'rtl/bsp/xilinx7'))
BOARD_SRC := boards/$(BOARD)/$(TOP).v $(sort $(wildcard boards/$(BOARD)/lib/*.v))
XDC := boards/$(BOARD)/$(TOP).xdc
FW_IMAGES := $(wildcard fw/cp/images/*.hex)

.PHONY: help menuconfig preset-minimal preset-balanced preset-high-perf lint sim sim-quick verilator check oxc-synth oxc-core oxc vivado prog-oxc prog-vivado clean replace-synopsis
.DEFAULT_GOAL := help

help:
	@echo 'Amaterrace GPU (BOARD=$(BOARD) TOP=$(TOP) PART=$(PART))'
	@echo ''
	@echo '  make menuconfig        interactive configuration menu (tools/menuconfig.py)'
	@echo '  make preset-minimal    apply minimal FPGA resource preset'
	@echo '  make preset-balanced   apply balanced preset (default)'
	@echo '  make preset-high-perf  apply high-performance preset'
	@echo '  make lint              Verilator lint of every module and top (tools/lint.sh)'
	@echo '  make sim          the iverilog testbenches (sim/run.sh, about 17 minutes)'
	@echo '  make sim-quick    the short run of the testbenches (sim/run.sh -q, a few minutes)'
	@echo '  make verilator    the Verilator system harness (sim/verilator/run.sh)'
	@echo '  make check        lint, sim and verilator'
	@echo '  make oxc-synth    openXC7: yosys synthesis only -> $(OXC)/$(TOP).json'
	@echo '  make oxc-core     openXC7: yosys synthesis of the GPU core atg_top in the KC705 shape'
	@echo '                   (CORE_PARAMS; no board stubs, so the logic is kept) -> $(BUILD)/openxc7/core'
	@echo '  make oxc          openXC7: synthesis, nextpnr, fpga-as -> $(OXC)/$(TOP).bit'
	@echo '  make vivado       Vivado batch build -> $(BUILD)/vivado/$(TOP)/$(TOP).bit'
	@echo '  make prog-oxc     load the openXC7 bitstream with openFPGALoader'
	@echo '  make prog-vivado  load the Vivado bitstream with openFPGALoader'
	@echo '  make clean        remove $(BUILD)/openxc7 and $(BUILD)/vivado'
	@echo ''
	@echo 'Variables: BOARD, TOP, PART, DIE, FAMILY, PRJXRAY_DB_DIR, OPENXC7_SHARE,'
	@echo '  CABLE (openFPGALoader -c, default digilent), FTDI_SERIAL (selects the board).'

menuconfig:
	python3 tools/menuconfig.py

preset-minimal:
	cp config/minimal.mk config.mk
	@$(MAKE) include/atg_config.vh

preset-balanced:
	cp config/balanced.mk config.mk
	@$(MAKE) include/atg_config.vh

preset-high-perf:
	cp config/high-perf.mk config.mk
	@$(MAKE) include/atg_config.vh

# ---------------------------------------------------------------- configuration header

include/atg_config.vh: $(CONFIG_MK_SRC)
	@mkdir -p include
	@echo "/* Automatically generated by Makefile from $(CONFIG_MK_SRC). DO NOT EDIT. */" > $@
	@echo "\`ifndef ATG_CONFIG_VH" >> $@
	@echo "\`define ATG_CONFIG_VH" >> $@
	@echo "" >> $@
	@echo "/* 1. Shader Unit (SU) */" >> $@
	@echo "\`define CFG_SU_NPHYS $(CONFIG_SU_NPHYS)" >> $@
	@echo "\`define CFG_SU_GRP_W $(CFG_SU_GRP_W)" >> $@
	@echo "\`define CFG_SU_NWARPS $(CONFIG_SU_NWARPS)" >> $@
	@echo "\`define CFG_SU_NREGS $(CONFIG_SU_NREGS)" >> $@
ifeq ($(CONFIG_SU_ENABLE_FP16),1)
	@echo "\`define CFG_ENABLE_FP16 1" >> $@
endif
ifeq ($(CONFIG_SU_ENABLE_SUBGROUP),1)
	@echo "\`define CFG_ENABLE_SUBGROUP 1" >> $@
endif
ifeq ($(CONFIG_SU_ENABLE_SFU),1)
	@echo "\`define CFG_ENABLE_SFU 1" >> $@
endif
	@echo "\`define CFG_SU_LDS_KB $(CONFIG_SU_LDS_KB)" >> $@
ifeq ($(CONFIG_SU_ENABLE_SA),1)
	@echo "\`define CFG_ENABLE_SA 1" >> $@
endif
ifeq ($(CONFIG_SU_ENABLE_MESH),1)
	@echo "\`define CFG_ENABLE_MESH 1" >> $@
endif
	@echo "" >> $@
	@echo "/* 2. Rasterizer (RX) */" >> $@
ifeq ($(CONFIG_RX_ENABLE_MSAA),1)
	@echo "\`ifndef CFG_ENABLE_MSAA" >> $@
	@echo "\`define CFG_ENABLE_MSAA 1" >> $@
	@echo "\`endif" >> $@
	@echo "\`ifndef CFG_MSAA_SAMPLES" >> $@
	@echo "\`define CFG_MSAA_SAMPLES $(CONFIG_RX_MSAA_SAMPLES)" >> $@
	@echo "\`endif" >> $@
endif
ifeq ($(CONFIG_RX_ENABLE_EARLY_Z),1)
	@echo "\`ifndef CFG_ENABLE_EARLY_Z" >> $@
	@echo "\`define CFG_ENABLE_EARLY_Z 1" >> $@
	@echo "\`endif" >> $@
endif
ifeq ($(CONFIG_RX_COARSE_SCAN),1)
	@echo "\`ifndef CFG_COARSE_SCAN" >> $@
	@echo "\`define CFG_COARSE_SCAN 1" >> $@
	@echo "\`endif" >> $@
endif
	@echo "" >> $@
	@echo "/* 3. Texture Unit (TU) */" >> $@
ifeq ($(CONFIG_TU_ENABLE_BC),1)
	@echo "\`define CFG_ENABLE_BC 1" >> $@
endif
ifeq ($(CONFIG_TU_ENABLE_ETC2),1)
	@echo "\`define CFG_ENABLE_ETC2 1" >> $@
endif
ifeq ($(CONFIG_TU_ENABLE_ANISO),1)
	@echo "\`define CFG_ENABLE_ANISO 1" >> $@
endif
ifeq ($(CONFIG_TU_ENABLE_SEAMLESS_CUBE),1)
	@echo "\`define CFG_ENABLE_SEAMLESS_CUBE 1" >> $@
endif
ifeq ($(CONFIG_TU_ENABLE_FP_FILTER),1)
	@echo "\`define CFG_ENABLE_FP_FILTER 1" >> $@
endif
ifeq ($(CONFIG_TU_ENABLE_ARRAY),1)
	@echo "\`define CFG_ENABLE_ARRAY 1" >> $@
endif
ifeq ($(CONFIG_TU_ENABLE_TRILINEAR),1)
	@echo "\`define CFG_ENABLE_TRILINEAR 1" >> $@
endif
ifeq ($(CONFIG_TU_ENABLE_3D_CUBE),1)
	@echo "\`define CFG_ENABLE_3D_CUBE 1" >> $@
endif
	@echo "\`define CFG_TU_L1_BANKS $(CONFIG_TU_L1_BANKS)" >> $@
	@echo "\`define CFG_TU_L1_CACHE_KB $(CONFIG_TU_L1_CACHE_KB)" >> $@
ifeq ($(CONFIG_TU_ENABLE_FFILT),1)
	@echo "\`define CFG_TU_ENABLE_FFILT 1" >> $@
else
	@echo "\`define CFG_TU_ENABLE_FFILT 0" >> $@
endif
ifeq ($(CONFIG_TU_ENABLE_MSHR),1)
	@echo "\`define CFG_ENABLE_MSHR 1" >> $@
endif
	@echo "" >> $@
	@echo "/* 4. Render Output Backend (ROP) & Formats */" >> $@
ifeq ($(CONFIG_FMT_ENABLE_FP16),1)
	@echo "\`define CFG_FMT_ENABLE_FP16 1" >> $@
endif
ifeq ($(CONFIG_FMT_ENABLE_FP32),1)
	@echo "\`define CFG_FMT_ENABLE_FP32 1" >> $@
endif
ifeq ($(CONFIG_FMT_ENABLE_SRGB),1)
	@echo "\`define CFG_FMT_ENABLE_SRGB 1" >> $@
endif
ifeq ($(CONFIG_FMT_ENABLE_RGB565),1)
	@echo "\`define CFG_FMT_ENABLE_RGB565 1" >> $@
endif
ifeq ($(CONFIG_FMT_ENABLE_DEPTH24_S8),1)
	@echo "\`define CFG_FMT_ENABLE_DEPTH24_S8 1" >> $@
endif
ifeq ($(CONFIG_FMT_ENABLE_DEPTH32F),1)
	@echo "\`define CFG_FMT_ENABLE_DEPTH32F 1" >> $@
endif
ifeq ($(CONFIG_FMT_ENABLE_DEPTH16),1)
	@echo "\`define CFG_FMT_ENABLE_DEPTH16 1" >> $@
endif
ifeq ($(CONFIG_ROP_ENABLE_FBLEND),1)
	@echo "\`define CFG_ROP_ENABLE_FBLEND 1" >> $@
else
	@echo "\`define CFG_ROP_ENABLE_FBLEND 0" >> $@
endif
ifeq ($(CONFIG_ROP_ENABLE_PACK),1)
	@echo "\`define CFG_ROP_ENABLE_PACK 1" >> $@
else
	@echo "\`define CFG_ROP_ENABLE_PACK 0" >> $@
endif
ifeq ($(CONFIG_ROP_DUAL_SOURCE),1)
	@echo "\`define CFG_ROP_DUAL_SOURCE 1" >> $@
endif
ifeq ($(CONFIG_ROP_ENABLE_LOGICOP),1)
	@echo "\`define CFG_ROP_ENABLE_LOGICOP 1" >> $@
endif
ifeq ($(CONFIG_ROP_FAST_CLEAR),1)
	@echo "\`define CFG_ROP_FAST_CLEAR 1" >> $@
endif
	@echo "\`define CFG_ROP_MRT_COUNT $(CONFIG_ROP_MRT_COUNT)" >> $@
	@echo "" >> $@
	@echo "/* 5. Command Processor (CP) & Memory Hierarchy */" >> $@
ifdef CONFIG_GPU_VA_BITS
	@echo "\`define CFG_GPU_VA_BITS $(CONFIG_GPU_VA_BITS)" >> $@
	@echo "\`define CFG_DWORD_ADDR_BITS ($$(($(CONFIG_GPU_VA_BITS) - 2)))" >> $@
	@echo "\`define CFG_LINE_ADDR_BITS ($$(($(CONFIG_GPU_VA_BITS) - 6)))" >> $@
	@echo "\`define CFG_VPN_BITS ($$(($(CONFIG_GPU_VA_BITS) - 12)))" >> $@
endif
ifdef CONFIG_HOST_PA_BITS
	@echo "\`define CFG_HOST_PA_BITS $(CONFIG_HOST_PA_BITS)" >> $@
	@echo "\`define CFG_PPN_BITS ($$(($(CONFIG_HOST_PA_BITS) - 12)))" >> $@
endif
ifeq ($(CONFIG_CP_AUTONOMOUS_MMU),1)
	@echo "\`define CFG_CP_AUTONOMOUS_MMU 1" >> $@
endif
ifeq ($(CONFIG_CP_USE_RV32_CORE),1)
	@echo "\`define CFG_CP_USE_RV32_CORE 1" >> $@
endif
ifeq ($(CONFIG_MC_ENABLE_PROT),1)
	@echo "\`define CFG_MC_ENABLE_PROT 1" >> $@
else
	@echo "\`define CFG_MC_ENABLE_PROT 0" >> $@
endif
	@echo "\`define CFG_MC_L2_CACHE_KB $(CONFIG_MC_L2_CACHE_KB)" >> $@
	@echo "\`define CFG_MC_L2_WAYS $(CONFIG_MC_L2_WAYS)" >> $@
	@echo "\`define CFG_VF_CACHE_LINES $(CONFIG_VF_CACHE_LINES)" >> $@
ifeq ($(CONFIG_DC_ENABLE_CURSOR),1)
	@echo "\`define CFG_DC_ENABLE_CURSOR 1" >> $@
endif
	@echo "" >> $@
	@echo "\`endif /* ATG_CONFIG_VH */" >> $@

lint: include/atg_config.vh
	tools/lint.sh

sim: include/atg_config.vh
	sim/run.sh

sim-quick: include/atg_config.vh
	sim/run.sh -q

verilator: include/atg_config.vh
	sim/verilator/run.sh

check: lint sim verilator

# ---------------------------------------------------------------- openXC7

$(OXC)/$(TOP).json: $(RTL) $(BOARD_SRC) $(FW_IMAGES) include/atg_config.vh
	mkdir -p $(OXC)
	cp $(FW_IMAGES) $(OXC)/
	cd $(OXC) && yosys -q -l yosys.log -p "read_verilog -I$(CURDIR)/include \
		$(addprefix $(CURDIR)/,$(RTL) $(BOARD_SRC)); \
		synth_xilinx -flatten -abc9 -arch xc7 -top $(TOP); write_json $(TOP).json"

oxc-synth: $(OXC)/$(TOP).json
	@grep -A40 'Number of cells' $(OXC)/yosys.log | grep -E 'LUT|FD|CARRY|RAMB|DSP' || true

# The GPU core alone (atg_top) in the KC705's shape: the board top's MIG,
# clock and JTAG are still port-only stubs, so synthesizing the board
# top removes all logic; this keeps it and reports the core's cells.
CORE_PARAMS ?= -set LINE_BYTES 64 -set LINE_SHIFT 6 -set DATA_W 512 -set HAS_CPU 1 \
	-set HAS_RX 1 -set HAS_ROP 1 -set NSU 1
CORE := $(BUILD)/openxc7/core

oxc-core: $(RTL) $(FW_IMAGES) include/atg_config.vh
	mkdir -p $(CORE)
	cp $(FW_IMAGES) $(CORE)/
	cd $(CORE) && yosys -q -l yosys.log -p "read_verilog -I$(CURDIR)/include \
		$(addprefix $(CURDIR)/,$(RTL)); chparam $(CORE_PARAMS) atg_top; \
		synth_xilinx -flatten -abc9 -arch xc7 -top atg_top; tee -o stat.txt stat"
	@grep -E 'LUT|FD|CARRY|RAMB|DSP' $(CORE)/stat.txt || true

$(CHIPDB):
	mkdir -p $(dir $@)
	python3 $(OPENXC7_SHARE)/nextpnr/himbaechel/uarch/xilinx/gen/xilinx_gen.py \
		--xray $(PRJXRAY_DB_DIR)/$(FAMILY) --device $(DIE) --bba $(@:.bin=.bba)
	bbasm -l $(@:.bin=.bba) $@

$(OXC)/$(TOP).bit: $(OXC)/$(TOP).json $(CHIPDB) $(XDC)
	nextpnr-himbaechel --chipdb $(CHIPDB) --device $(PART) --json $< \
		-o xdc=$(XDC) -o fasm=$(OXC)/$(TOP).fasm --log $(OXC)/nextpnr.log
	fpga-as --prjxray_db_path=$(PRJXRAY_DB_DIR)/$(FAMILY) --part $(PART) \
		$(OXC)/$(TOP).fasm > $@

oxc: $(OXC)/$(TOP).bit
	@grep 'Max frequency for clock' $(OXC)/nextpnr.log | tail -3 || true

# ---------------------------------------------------------------- Vivado

vivado:
	tools/vivado-build.sh $(BOARD) $(TOP)

# ---------------------------------------------------------------- loading

CABLE ?= digilent
FTDI_SERIAL ?=
LOADER = openFPGALoader -c $(CABLE) $(if $(FTDI_SERIAL),--ftdi-serial $(FTDI_SERIAL))

prog-oxc: $(OXC)/$(TOP).bit
	$(LOADER) $<

prog-vivado:
	$(LOADER) $(BUILD)/vivado/$(TOP)/$(TOP).bit

clean:
	rm -rf $(BUILD)/openxc7 $(BUILD)/vivado include/atg_config.vh

# ---------------------------------------------------------------- Synopsys conversion

replace-synopsis:
	python3 tools/replace-synopsys.py $(if $(IN_PLACE),--in-place,--out-dir $(BUILD)/synopsys)

